{
  "$comment": "Matriz de SPEC-056. Fuente única para el test de arquitectura y para eslint.config.js.",
  "layers": [
    { "name": "core", "src": "packages/core/src", "manifest": "packages/core/package.json", "allowed": [], "pure": true },
    { "name": "editor", "src": "packages/editor/src", "manifest": "packages/editor/package.json", "allowed": ["core"], "pure": true },
    { "name": "ui", "src": "packages/ui/src", "manifest": "packages/ui/package.json", "allowed": ["core", "editor"], "pure": true, "react": true },
    { "name": "claude", "src": "packages/claude/src", "manifest": "packages/claude/package.json", "allowed": ["core"] },
    { "name": "store", "src": "packages/store/src", "manifest": "packages/store/package.json", "allowed": ["core"] },
    { "name": "workspace", "src": "packages/workspace/src", "manifest": "packages/workspace/package.json", "allowed": ["core"] },
    { "name": "runtime", "src": "packages/runtime/src", "manifest": "packages/runtime/package.json", "allowed": ["core"] },
    { "name": "desktop-main", "src": "apps/desktop/src/main", "manifest": "apps/desktop/package.json", "allowed": ["core", "editor", "ui", "claude", "store", "workspace", "runtime"] },
    { "name": "desktop-preload", "src": "apps/desktop/src/preload", "allowed": ["core", "editor"], "typesOnly": ["core"] },
    { "name": "desktop-renderer", "src": "apps/desktop/src/renderer", "allowed": ["editor", "ui"] }
  ],
  "contexts": {
    "root": "packages/core/src",
    "rules": {
      "shared": [],
      "diagrams": ["shared"],
      "knowledge": ["shared"],
      "settings": ["shared"],
      "execution": ["shared", "diagrams", "knowledge", "settings"],
      "ports": ["shared", "diagrams", "knowledge", "settings", "execution"],
      "testing": ["shared", "diagrams", "knowledge", "settings", "execution", "ports"]
    },
    "typesOnly": ["ports"]
  },
  "forbiddenInPure": ["electron", "@anthropic-ai/*"]
}
